# Example systemd user unit — run the VPN jumphost (openconnect +
# ocproxy + routing proxy + optional PAC server) as a single supervised
# process.
#
# The unit invokes the `jumphost` binary, which:
#   - validates the F5 MRHSession cookie and refreshes it via the browser
#     login flow (`jumphost fetch-cookie`) when it expires,
#   - starts openconnect with --script-tun --script "ocproxy ...",
#   - serves the PAC file on 127.0.0.1:8091 when serve_pac = true in config.toml,
#   - re-checks the cookie at the configured check_interval (default 300 s),
#   - restarts openconnect if the cookie was refreshed,
#   - limits automated Authenticator pushes to three; after that it stays
#     running without a tunnel until a valid cookie is supplied manually,
#   - detects laptop sleep/wake (logind PrepareForSleep signal on Linux,
#     wall-clock fallback elsewhere) and re-validates immediately on wake.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/vpn-jumphost.service.example ~/.config/systemd/user/vpn-jumphost.service
#   Edit ExecStart paths to your clone of this repository.
#   systemctl --user daemon-reload
#   systemctl --user enable --now vpn-jumphost.service
#
# Logs:
#   journalctl --user -u vpn-jumphost.service -f
#
# Notes:
#   - Cookie auto-refresh drives Chromium via CDP. When VPN_USERNAME and
#     VPN_PASSWORD are set, the common-case Authenticator push MFA flow
#     works entirely headless: the number-match value is delivered as a
#     desktop notification via D-Bus (notify-rust crate — no external
#     notify-send binary needed) and the browser never opens a window.
#     A graphical session (DISPLAY / WAYLAND_DISPLAY / XDG_RUNTIME_DIR)
#     is only needed if a TOTP or other interactive MFA prompt is
#     triggered, which causes the headless browser to relaunch in headed
#     mode. systemctl --user units inherit the graphical session env on
#     most desktops, so this fallback still works when one is available.
#   - openconnect, ocproxy, and chromium must be on PATH (set via the
#     unit's Environment=PATH= line, or by sourcing a wrapper that enters
#     the devenv shell).
#   - Run `just build` once before enabling the unit so the binary exists
#     at `target/release/jumphost`.

[Unit]
Description=VPN jumphost (openconnect + ocproxy, supervised)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Replace /CHANGE/ME with the absolute path to your checkout.
WorkingDirectory=/CHANGE/ME/vpn-jumphost

# Make sure openconnect, ocproxy, and chromium are on PATH.
# Easiest is to point PATH at your devenv profile or a nix profile that
# has these binaries; otherwise list each bin directory explicitly.
Environment=PATH=/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin

# Optional knobs (uncomment to override defaults):
# Environment=VPN_USERNAME=your.email@company.com
# Environment=VPN_PASSWORD=...  # prefer EnvironmentFile= with mode 600

# Replace /CHANGE/ME with the absolute path to your checkout.
ExecStart=/CHANGE/ME/vpn-jumphost/target/release/jumphost run

# SIGTERM goes to the jumphost supervisor, which cleanly stops openconnect
# (and ocproxy with it), the routing proxy, and the PAC server.
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
