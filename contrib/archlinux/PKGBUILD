# Maintainer: VPN Jumphost contributors
pkgname=vpn-jumphost
pkgver=0.2.0
pkgrel=1
pkgdesc='VPN jumphost: OpenConnect+ocproxy supervisor with routing SOCKS5 proxy, PAC server, and cookie management'
arch=('x86_64' 'aarch64')
url='https://github.com/VITO-RMA/vpn-jumphost'
license=('MIT')
depends=('dbus' 'openconnect' 'ocproxy' 'chromium')
makedepends=('cargo' 'dbus')
install=vpn-jumphost.install
backup=()
# Disable makepkg's C/C++ LTO: Rust crates with bundled native code (e.g. ring/aws-lc-sys)
# can fail to link under Arch's default lto option. Cargo's dist profile independently
# enables Rust thin LTO for the packaged binary.
options=(!debug !lto)
source=()
sha256sums=()

_reporoot() {
  cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd
}

build() {
  cd "$(_reporoot)"
  cargo build --profile dist --locked
}

package() {
  cd "$(_reporoot)"

  # Binary
  install -Dm755 target/dist/jumphost "$pkgdir/usr/bin/jumphost"

  # License
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # systemd user unit
  install -Dm644 contrib/archlinux/vpn-jumphost.service "$pkgdir/usr/lib/systemd/user/vpn-jumphost.service"

  # Example config
  install -Dm644 docs/config.example.toml "$pkgdir/usr/share/vpn-jumphost/config.example.toml"

  # Shell completions
  local bin="./target/dist/jumphost"
  install -d "$pkgdir/usr/share/bash-completion/completions"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  "$bin" generate-completions bash > "$pkgdir/usr/share/bash-completion/completions/jumphost"
  "$bin" generate-completions zsh  > "$pkgdir/usr/share/zsh/site-functions/_jumphost"
  "$bin" generate-completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/jumphost.fish"
}
