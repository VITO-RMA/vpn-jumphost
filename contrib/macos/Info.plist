<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal Info.plist for the Jumphost.app bundle.

  This .app bundle exists solely so macOS registers the bundle identifier
  with Launch Services.  Once registered, the notify-rust crate
  (mac-notification-sys backend) can call set_application() with this ID
  and NSUserNotificationCenter will deliver notifications under the
  "Jumphost" name in System Settings → Notifications.

  The actual executable inside MacOS/ is a symlink to /usr/local/bin/jumphost.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>sas.vpn-jumphost</string>

  <key>CFBundleName</key>
  <string>Jumphost</string>

  <key>CFBundleDisplayName</key>
  <string>VPN Jumphost</string>

  <key>CFBundleExecutable</key>
  <string>jumphost</string>

  <key>CFBundleVersion</key>
  <string>0.2.0</string>

  <key>CFBundleShortVersionString</key>
  <string>0.2.0</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>

  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>

  <!-- Background-only: no Dock icon, no menu bar. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
