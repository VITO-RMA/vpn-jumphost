set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

pkg_name := "vpn-jumphost"
label := "sas.vpn-jumphost"

macos_dir := justfile_directory()
repo_root := macos_dir / "../.."
pkg_cache := ".pkg-cache"

default:
    @just --list

# Build the release binary and assemble the .pkg installer.
build-package:
    mkdir -p {{ pkg_cache }}
    cd "{{ repo_root }}" && cargo build --release
    cd "{{ pkg_cache }}" && bash "{{ macos_dir }}/build-pkg.sh"

# Install the .pkg (requires sudo for /usr/local/bin + /Applications).
install: build-package
    @pkg=$(ls -1t {{ pkg_cache }}/{{ pkg_name }}-*.pkg 2>/dev/null | head -1) && \
    if [ -z "$pkg" ]; then echo "No .pkg found"; exit 1; fi && \
    echo "Installing $pkg ..." && \
    sudo installer -pkg "$pkg" -target /

# Uninstall vpn-jumphost from the system.
uninstall:
    bash "{{ macos_dir }}/uninstall.sh"

# Verify the installed binary runs and the .app is registered.
test-install: install
    #!/usr/bin/env bash
    set -euo pipefail
    echo "── binary ──"
    /usr/local/bin/jumphost --help | head -3
    echo ""
    echo "── app bundle ──"
    test -d /Applications/Jumphost.app && echo "OK: Jumphost.app exists"
    test -L /Applications/Jumphost.app/Contents/MacOS/jumphost && echo "OK: symlink present"
    echo ""
    echo "── launch services ──"
    LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    if "$LSREGISTER" -dump | grep -q "{{ label }}"; then
        echo "OK: bundle identifier registered"
    else
        echo "WARN: bundle identifier not found in lsregister dump"
    fi
    echo ""
    echo "── launchd agent ──"
    if launchctl print "gui/$(id -u)/{{ label }}" >/dev/null 2>&1; then
        echo "OK: agent loaded"
    else
        echo "WARN: agent not loaded (may need login/logout)"
    fi
    echo ""
    echo "── notification test ──"
    /usr/local/bin/jumphost test-notification
    echo ""
    echo "All checks passed."

# Show the launchd agent status.
status:
    @launchctl print "gui/$(id -u)/{{ label }}" 2>/dev/null || echo "Agent not loaded."

# Restart the launchd agent.
restart:
    @launchctl kickstart -k "gui/$(id -u)/{{ label }}"

# Stop the launchd agent.
stop:
    @launchctl kill SIGTERM "gui/$(id -u)/{{ label }}" 2>/dev/null || echo "Agent not running."

# View logs.
logs:
    @tail -f /tmp/vpn-jumphost.log

clean:
    rm -rf {{ pkg_cache }}
